[TEMPLATE]
PORT=4000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=campuscarry
JWT_SECRET=campuscarry_super_secret_key_change_this
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Razorpay (get keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_TEST_MODE=true

# FCM / Firebase (optional — for push notifications)
# Set GOOGLE_APPLICATION_CREDENTIALS to path of service-account.json
# Or paste JSON as FCM_SERVICE_ACCOUNT env var
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT=
